		displayFolder: 10 Ficha HTML

	measure 'HTML Painel' = ```
			-- Página Painel do Comissário. O build expande o template src/html/painel.html
			"<style>/* Gotham Noir — design tokens (dono: designer-ui). Contrato: contracts/design-tokens.md */
			:root {
			--g-bg: #07090c;
			--g-panel: #10141a;
			--g-line: #1f2a36;
			--g-text: #d7dde4;
			--g-muted: #7d8794;
			--bat-yellow: #f5c518;
			--arkham-green: #39d98a;
			--joker-purple: #7b2cbf;
			--blood: #c1121f;
			--ice: #8ecae6;
			--ivy: #2d6a4f;
			--owl-bronze: #a47148;
			--font-ui: 'Rajdhani', 'Barlow Condensed', 'Arial Narrow', sans-serif;
			--font-mono: 'JetBrains Mono', Consolas, monospace;
			--font-title: 'Bebas Neue', Impact, sans-serif;
			--t-fast: 150ms;
			--t-med: 300ms;
			}
			/* Painel do Comissário (plano §3.7) — layout em grade, barras e cards de personagem */
			.gd-painel {
			position: relative;
			overflow: hidden;
			min-height: 100%;
			padding: 16px 20px 12px;
			box-sizing: border-box;
			background: radial-gradient(ellipse at 50% -10%, #1a2330 0%, var(--g-bg) 55%);
			color: var(--g-text);
			font-family: var(--font-ui);
			}
			.gd-rain {
			position: absolute;
			inset: -50% -50% 0 -50%;
			pointer-events: none;
			background-image: repeating-linear-gradient(105deg, transparent 0 18px, rgba(215, 221, 228, 0.05) 18px 19px);
			animation: gd-chuva 0.7s linear infinite;
			}
			@keyframes gd-chuva {
			from { transform: translate3d(0, -40px, 0); }
			to { transform: translate3d(-11px, 0, 0); }
			}
			.gd-top, .gd-kpis, .gd-cols, .gd-arquivo, .gd-rodape { position: relative; }
			.gd-top {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			border-bottom: 1px solid var(--g-line);
			padding-bottom: 8px;
			margin-bottom: 12px;
			}
			.gd-title { font-family: var(--font-title); font-size: 30px; letter-spacing: 2px; color: var(--bat-yellow); }
			.gd-pag { margin-left: 12px; font-family: var(--font-mono); font-size: 13px; color: var(--g-text); text-transform: uppercase; letter-spacing: 2px; }
			.gd-sub { color: var(--g-muted); font-size: 13px; }
			.gd-kpis { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-bottom: 12px; }
			.gd-kpi { background: var(--g-panel); border: 1px solid var(--g-line); border-left: 3px solid var(--bat-yellow); border-radius: 6px; padding: 8px 12px; }
			.gd-kpi b { display: block; font-family: var(--font-mono); font-size: 26px; color: var(--g-text); }
			.gd-kpi span { color: var(--g-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; }
			.gd-cols { display: grid; grid-template-columns: 1fr 1.3fr 1fr; gap: 12px; margin-bottom: 12px; }
			.gd-box { background: rgba(16, 20, 26, 0.92); border: 1px solid var(--g-line); border-radius: 6px; padding: 10px 14px; }
			.gd-box h2 { margin: 0 0 8px; font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--bat-yellow); text-transform: uppercase; letter-spacing: 1.5px; }
			.gd-nota { margin: -6px 0 8px; color: var(--g-muted); font-size: 11px; }
			.gd-bar { display: grid; grid-template-columns: 92px 1fr 52px; align-items: center; gap: 8px; margin: 5px 0; font-size: 13px; }
			.gd-bl { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.gd-bt { height: 10px; background: var(--g-line); border-radius: 5px; overflow: hidden; }
			.gd-bt i { display: block; height: 100%; background: linear-gradient(90deg, var(--bat-yellow), #c99c00); border-radius: 5px; transform-origin: left; animation: gd-cresce 0.9s ease-out; }
			.gd-bv { text-align: right; font-family: var(--font-mono); font-size: 12px; color: var(--g-muted); }
			.gd-colunas { display: flex; align-items: flex-end; gap: 6px; height: 150px; }
			.gd-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
			.gd-cv { font-family: var(--font-mono); font-size: 11px; color: var(--g-muted); }
			.gd-ct { flex: 1; width: 70%; display: flex; align-items: flex-end; }
			.gd-ct i { display: block; width: 100%; background: linear-gradient(0deg, #c99c00, var(--bat-yellow)); border-radius: 3px 3px 0 0; transform-origin: bottom; animation: gd-sobe 0.9s ease-out; }
			.gd-cl { margin-top: 4px; font-size: 10px; color: var(--g-muted); text-align: center; line-height: 1.1; height: 24px; }
			@keyframes gd-cresce { from { transform: scaleX(0); } to { transform: scaleX(1); } }
			@keyframes gd-sobe { from { transform: scaleY(0); } to { transform: scaleY(1); } }
			.gd-grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 8px; }
			.gd-ficha { position: relative; background: var(--g-panel); border: 1px solid var(--g-line); border-radius: 6px; overflow: hidden; transition: transform var(--t-fast); }
			.gd-ficha:hover { transform: translateY(-3px); }
			.gd-foto { height: 120px; background: radial-gradient(circle at 50% 35%, #2a3542 0 22%, transparent 23%), radial-gradient(ellipse at 50% 100%, #2a3542 0 45%, var(--g-bg) 46%); }
			.gd-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
			.gd-faixa { height: 4px; background: var(--g-muted); }
			.gd-ficha b { display: block; padding: 6px 8px 0; font-size: 14px; line-height: 1.15; }
			.gd-ficha span { display: block; padding: 0 8px; color: var(--g-muted); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.gd-ficha em { display: block; padding: 4px 8px 7px; font-style: normal; font-family: var(--font-mono); font-size: 9px; color: var(--g-muted); }
			.fx-batfamilia .gd-faixa { background: var(--bat-yellow); }
			.fx-coringa .gd-faixa { background: var(--joker-purple); }
			.fx-espantalho .gd-faixa, .fx-charada .gd-faixa { background: var(--arkham-green); }
			.fx-frio .gd-faixa { background: var(--ice); }
			.fx-hera .gd-faixa { background: var(--ivy); }
			.fx-duascaras .gd-faixa, .fx-vagalume .gd-faixa { background: var(--blood); }
			.fx-corujas .gd-faixa { background: var(--owl-bronze); }
			.gd-rodape { margin-top: 10px; color: var(--g-muted); font-size: 11px; text-align: center; }
			@media (prefers-reduced-motion: reduce) {
			.gd-rain, .gd-bt i, .gd-ct i { animation: none; }
			.gd-ficha { transition: none; }
			}
			@media (max-width: 900px) {
			.gd-kpis { grid-template-columns: repeat(2, 1fr); }
			.gd-cols { grid-template-columns: 1fr; }
			}
			</style>
			<div class='gd-painel'>
			<div class='gd-rain'></div>
			<header class='gd-top'>
			<div><span class='gd-title'>GOTHAM DATABASE</span><span class='gd-pag'>Painel do Comissário</span></div>
			<span class='gd-sub'>Batcomputador em Power BI · medidas DAX que geram HTML/CSS</span>
			</header>
			<section class='gd-kpis'>"
			& ( [Painel KPIs] )
			& "</section>
			<div class='gd-cols'>
			<section class='gd-box'><h2>Aparições por mídia</h2>"
			& ( [Painel Barras Midia] )
			& "</section>
			<section class='gd-box'><h2>Obras por era editorial</h2><div class='gd-colunas'>"
			& ( [Painel Barras Era] )
			& "</div></section>
			<section class='gd-box'><h2>Quem conecta o universo</h2><p class='gd-nota'>intermediação na rede de relações</p>"
			& ( [Painel Hubs] )
			& "</section>
			</div>
			<section class='gd-box gd-arquivo'><h2>Arquivo de personagens</h2><div class='gd-grade'>"
			& ( [Painel Grade] )
			& "</div></section>
			<footer class='gd-rodape'>Dados: Wikidata (CC0), Wikipédia, SuperHero API · projeto pessoal, sem fins comerciais · Batman e personagens © DC Comics</footer>
			</div>
			"
			```
		displayFolder: 10 Ficha HTML

	measure 'HTML Spike' = ```
			-- HTML + CSS + JS do spike. O build expande o template src/html/spike.html
			"<style>/* Gotham Noir — design tokens (dono: designer-ui). Contrato: contracts/design-tokens.md */
			:root {
			--g-bg: #07090c;
			--g-panel: #10141a;
			--g-line: #1f2a36;
			--g-text: #d7dde4;
			--g-muted: #7d8794;
			--bat-yellow: #f5c518;
			--arkham-green: #39d98a;
			--joker-purple: #7b2cbf;
			--blood: #c1121f;
			--ice: #8ecae6;
			--ivy: #2d6a4f;
			--owl-bronze: #a47148;
			--font-ui: 'Rajdhani', 'Barlow Condensed', 'Arial Narrow', sans-serif;
			--font-mono: 'JetBrains Mono', Consolas, monospace;
			--font-title: 'Bebas Neue', Impact, sans-serif;
			--t-fast: 150ms;
			--t-med: 300ms;
			}
			/* F0 spike: chuva em CSS puro + cards de diagnóstico */
			.gd-spike {
			position: relative;
			overflow: hidden;
			min-height: 100%;
			padding: 16px;
			box-sizing: border-box;
			background: radial-gradient(ellipse at 50% -20%, #1a2330 0%, var(--g-bg) 60%);
			color: var(--g-text);
			font-family: var(--font-mono);
			}
			.gd-rain {
			position: absolute;
			inset: -50% -50% 0 -50%;
			pointer-events: none;
			background-image: repeating-linear-gradient(105deg, transparent 0 18px, rgba(215, 221, 228, 0.07) 18px 19px);
			animation: gd-chuva 0.6s linear infinite;
			}
			@keyframes gd-chuva {
			from { transform: translate3d(0, -40px, 0); }
			to { transform: translate3d(-11px, 0, 0); }
			}
			.gd-top {
			position: relative;
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			border-bottom: 1px solid var(--g-line);
			padding-bottom: 8px;
			margin-bottom: 12px;
			}
			.gd-title {
			font-family: var(--font-title);
			font-size: 28px;
			letter-spacing: 2px;
			color: var(--bat-yellow);
			}
			.gd-sub { color: var(--g-muted); font-size: 12px; }
			.gd-grid {
			position: relative;
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
			gap: 10px;
			}
			.gd-card {
			background: var(--g-panel);
			border: 1px solid var(--g-line);
			border-radius: 6px;
			padding: 10px 12px;
			}
			.gd-k { color: var(--g-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; }
			.gd-v { font-size: 20px; margin-top: 4px; }
			.gd-ok { color: var(--arkham-green); }
			.gd-ok::before { content: '✔ '; }
			.gd-no { color: var(--g-muted); }
			.gd-no::before { content: '✖ '; }
			.gd-btn {
			margin-top: 8px;
			background: transparent;
			color: var(--bat-yellow);
			border: 1px solid var(--bat-yellow);
			border-radius: 4px;
			font: inherit;
			padding: 4px 10px;
			cursor: pointer;
			transition: transform var(--t-fast);
			}
			.gd-btn:hover { transform: translateY(-1px); }
			.gd-btn:focus-visible { outline: 2px solid var(--bat-yellow); outline-offset: 2px; }
			.gd-sky {
			position: relative;
			display: block;
			width: 100%;
			height: 90px;
			margin-top: 12px;
			border: 1px solid var(--g-line);
			border-radius: 6px;
			}
			.gd-log { position: relative; margin-top: 8px; color: var(--g-muted); font-size: 11px; }
			@media (prefers-reduced-motion: reduce) {
			.gd-rain { animation: none; }
			.gd-btn { transition: none; }
			}
			</style>
			<div class='gd-spike' id='gd-spike'>
			<div class='gd-rain'></div>
			<header class='gd-top'>
			<span class='gd-title'>GOTHAM DATABASE</span>
			<span class='gd-sub'>F0 · spike técnico · <span id='gd-desde'>JS não executou</span></span>
			</header>
			<div class='gd-grid'>
			<div class='gd-card'><div class='gd-k'>JS via script</div><div class='gd-v gd-no' id='gd-js-script'>inativo</div></div>
			<div class='gd-card'><div class='gd-k'>JS via onerror</div><div class='gd-v gd-no' id='gd-js-img'>inativo</div></div>
			<div class='gd-card'><div class='gd-k'>Renderizações</div><div class='gd-v' id='gd-renders'>–</div></div>
			<div class='gd-card'><div class='gd-k'>Contador (window)</div><div class='gd-v' id='gd-count'>–</div><button class='gd-btn' id='gd-inc' type='button'>+1</button></div>
			<div class='gd-card'><div class='gd-k'>Payload pedido</div><div class='gd-v'>"
			& ( [Spike Tamanho Rotulo] )
			& "</div><div class='gd-k' id='gd-size'></div></div>
			<div class='gd-card'><div class='gd-k'>Linhas no modelo</div><div class='gd-v'>"
			& ( [Spike Linhas] )
			& "</div></div>
			</div>
			<canvas class='gd-sky' id='gd-sky' aria-label='Holofote varrendo as nuvens'></canvas>
			<div class='gd-log'>Clique em +1, troque o slicer de tamanho e volte: o contador deve continuar.</div>
			<div id='gd-payload' hidden>"
			& ( [Spike Payload] )
			& "</div>
			</div>
			<script id='gd-src'>// F0 spike: prova que o visual executa JS e que o estado em window.GOTHAM_STATE
			// sobrevive ao redesenho. PROIBIDO aspas duplas (quebram a string DAX).
			(function (G) {
			const S = (G.GOTHAM_STATE = G.GOTHAM_STATE || {});
			const L = (G.GOTHAM_SPIKE = G.GOTHAM_SPIKE || {});
			// ---- lógica pura (testada em Node, tests/js/spike.test.js) ----
			L.novoEstado = function (agora) {
			return { contador: 0, renders: 0, vias: [], inicio: agora, raf: 0 };
			};
			L.registrarRender = function (st, via) {
			st.renders += 1;
			if (st.vias.indexOf(via) < 0) st.vias.push(via);
			return st;
			};
			L.incrementar = function (st) {
			st.contador += 1;
			return st.contador;
			};
			// varredura senoidal do holofote: x em [0,1 .. 0,9] da largura
			L.posicaoHolofote = function (t, largura) {
			return largura / 2 + Math.sin(t / 1400) * largura * 0.4;
			};
			L.formatarHora = function (ms) {
			const d = new Date(ms);
			const p = (n) => String(n).padStart(2, '0');
			return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
			};
			// ---- renderização (só no navegador) ----
			const doc = G.document;
			if (!doc) return;
			const raiz = doc.getElementById('gd-spike');
			if (!raiz || raiz.dataset.gdRan) return; // já rodou neste DOM (script + onerror)
			raiz.dataset.gdRan = '1';
			const via = doc.currentScript ? 'script' : 'onerror';
			const st = (S.spike = S.spike || L.novoEstado(Date.now()));
			L.registrarRender(st, via);
			const $ = (id) => doc.getElementById(id);
			const marcar = (id, ok) => {
			const el = $(id);
			if (!el) return;
			el.textContent = ok ? 'ativo' : 'inativo';
			el.className = 'gd-v ' + (ok ? 'gd-ok' : 'gd-no');
			};
			function pintar() {
			marcar('gd-js-script', via === 'script');
			if (via === 'onerror') marcar('gd-js-img', true);
			$('gd-renders').textContent = String(st.renders);
			$('gd-count').textContent = String(st.contador);
			$('gd-desde').textContent = 'estado desde ' + L.formatarHora(st.inicio);
			const pl = $('gd-payload');
			$('gd-size').textContent = (pl ? pl.textContent.length : 0).toLocaleString('pt-BR') + ' recebidos';
			}
			$('gd-inc').addEventListener('click', () => {
			L.incrementar(st);
			pintar();
			});
			pintar();
			// holofote varrendo as nuvens; cancela o loop do render anterior para não duplicar
			if (st.raf) G.cancelAnimationFrame(st.raf);
			const cv = $('gd-sky');
			const ctx = cv && cv.getContext ? cv.getContext('2d') : null;
			if (!ctx) return;
			const calmo = G.matchMedia && G.matchMedia('(prefers-reduced-motion: reduce)').matches;
			function quadro(t) {
			const w = (cv.width = cv.clientWidth || 320);
			const h = (cv.height = cv.clientHeight || 90);
			ctx.fillStyle = '#07090c';
			ctx.fillRect(0, 0, w, h);
			const x = L.posicaoHolofote(calmo ? 0 : t, w);
			const g = ctx.createLinearGradient(w / 2, h, x, 0);
			g.addColorStop(0, 'rgba(245,197,24,0.45)');
			g.addColorStop(1, 'rgba(245,197,24,0.02)');
			ctx.fillStyle = g;
			ctx.beginPath();
			ctx.moveTo(w / 2 - 6, h);
			ctx.lineTo(x - 40, 0);
			ctx.lineTo(x + 40, 0);
			ctx.lineTo(w / 2 + 6, h);
			ctx.fill();
			ctx.fillStyle = 'rgba(125,135,148,0.18)';
			for (let i = 0; i < 6; i++) {
			const cx = ((i * 97 + (calmo ? 0 : t / 60)) % (w + 120)) - 60;
			ctx.beginPath();
			ctx.ellipse(cx, 18 + (i % 3) * 10, 50, 10, 0, 0, Math.PI * 2);
			ctx.fill();
			}
			if (!calmo && raiz.isConnected) st.raf = G.requestAnimationFrame(quadro);
			}
			st.raf = G.requestAnimationFrame(quadro);
			})(typeof window !== 'undefined' ? window : globalThis);
			</script>
			<img src='data:,' alt='' style='display:none' onerror='var r=document.getElementById(`gd-spike`),s=document.getElementById(`gd-src`);if(r&&s&&!r.dataset.gdRan){new Function(s.textContent)()}else if(r){var e=document.getElementById(`gd-js-img`);e.textContent=`ativo`;e.className=`gd-v gd-ok`}'>
			"
			```
		displayFolder: 99 Spike

	measure 'JS Gotham' = ```
			-- Serializa o modelo no objeto window.GOTHAM (contrato: contracts/js-data-schema.json, v0.2).
			-- TODO texto vindo de dados passa pelo escape de string JS entre aspas simples:
			--   \ -> \\   ' -> \'   </ -> <\/   LF -> \n   CR -> \r      (teste: tests/build/test_build.py)
			-- Números com FORMAT en-US. Dimensões iteradas com ALLNOBLANKROW: chave estrangeira vazia
			-- (ex.: dGadget[SoContraArquetipo]) cria um membro em branco que, com ALL, deslocaria a matriz.
			VAR _ar =
			    CONCATENATEX (
			        ALLNOBLANKROW ( dArquetipo ),
			        VAR _s = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dArquetipo[Sigla], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _n = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dArquetipo[Nome], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _c = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dArquetipo[Cor], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        RETURN "{id:" & dArquetipo[IdArquetipo] & ",s:'" & _s & "',n:'" & _n & "',c:'" & _c & "'}",
			        ",", dArquetipo[IdArquetipo], ASC
			    )
			VAR _m =
			    CONCATENATEX (
			        ALLNOBLANKROW ( dArquetipo ),
			        VAR _atk = dArquetipo[IdArquetipo]
			        RETURN
			            "[" & CONCATENATEX (
			                FILTER ( ALL ( fMatchup ), fMatchup[IdAtaque] = _atk ),
			                FORMAT ( fMatchup[Multiplicador], "0.0#", "en-US" ),
			                ",", fMatchup[IdDefesa], ASC
			            ) & "]",
			        ",", dArquetipo[IdArquetipo], ASC
			    )
			VAR _er =
			    CONCATENATEX (
			        ALLNOBLANKROW ( dEra ),
			        VAR _n = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dEra[Nome], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        RETURN "{id:" & dEra[IdEra] & ",n:'" & _n & "',i:" & dEra[AnoInicio] & "}",
			        ",", dEra[Ordem], ASC
			    )
			VAR _af =
			    CONCATENATEX (
			        ALLNOBLANKROW ( dAfiliacao ),
			        VAR _n = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dAfiliacao[Nome], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        RETURN "{id:" & dAfiliacao[IdAfiliacao] & ",n:'" & _n & "'}",
			        ",", dAfiliacao[IdAfiliacao], ASC
			    )
			VAR _md =
			    CONCATENATEX (
			        ALLNOBLANKROW ( dMidia ),
			        VAR _n = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dMidia[Nome], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        RETURN "'" & _n & "'",
			        ",", dMidia[IdMidia], ASC
			    )
			VAR _v =
			    CONCATENATEX (
			        ALLNOBLANKROW ( dVersao ),
			        VAR _n = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dVersao[NomeVersao], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _img = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dVersao[UrlImagem], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _r = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dVersao[Raridade], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        RETURN
			            "{id:" & dVersao[IdVersao] & ",p:" & dVersao[IdPersonagem] & ",n:'" & _n & "',a:" & dVersao[IdArquetipo]
			                & ",s:[" & dVersao[Int] & "," & dVersao[For] & "," & dVersao[Vel] & "," & dVersao[Dur] & "," & dVersao[Pod]
			                & "," & dVersao[Com] & "],img:'" & _img & "',t:" & dVersao[EhTransformacao] & ",r:'" & _r & "'}",
			        ",", dVersao[IdVersao], ASC
			    )
			VAR _p =
			    CONCATENATEX (
			        ALLNOBLANKROW ( dPersonagem ),
			        VAR _id = dPersonagem[IdPersonagem]
			        -- versão padrão = menor IdVersao do personagem que não é transformação (sem depender de Id×100+1)
			        VAR _v =
			            COALESCE (
			                MINX ( FILTER ( ALLNOBLANKROW ( dVersao ), dVersao[IdPersonagem] = _id && dVersao[EhTransformacao] = 0 ), dVersao[IdVersao] ),
			                MINX ( FILTER ( ALLNOBLANKROW ( dVersao ), dVersao[IdPersonagem] = _id ), dVersao[IdVersao] ),
			                0
			            )
			        VAR _n = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[Nome], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _c = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[Codinome], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _ci = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[IdentidadeCivil], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _al = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[Alinhamento], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _f = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[Faccao], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _e = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[PrimeiraAparicao], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _me = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[MidiaEstreia], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _cr = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[Criadores], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _j = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dPersonagem[JustificativaArquetipo], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _afs =
			            CONCATENATEX (
			                FILTER ( ALL ( bPersonagemAfiliacao ), bPersonagemAfiliacao[IdPersonagem] = _id ),
			                bPersonagemAfiliacao[IdAfiliacao], ",", bPersonagemAfiliacao[IdAfiliacao], ASC
			            )
			        VAR _ap =
			            CONCATENATEX (
			                ALLNOBLANKROW ( dMidia ),
			                VAR _md = dMidia[IdMidia]
			                RETURN
			                    COUNTROWS (
			                        FILTER ( ALL ( fAparicao ), fAparicao[IdPersonagem] = _id && RELATED ( dObra[IdMidia] ) = _md )
			                    ) + 0,
			                ",", dMidia[IdMidia], ASC
			            )
			        VAR _cen = FILTER ( ALLNOBLANKROW ( dCentralidade ), dCentralidade[IdPersonagem] = _id )
			        VAR _gr = MAXX ( _cen, dCentralidade[Grau] ) + 0
			        VAR _in = MAXX ( _cen, dCentralidade[Intermediacao] ) + 0
			        RETURN
			            "{id:" & _id & ",n:'" & _n & "',c:'" & _c & "',ci:'" & _ci & "',al:'" & _al & "',a:" & dPersonagem[IdArquetipo]
			                & ",f:'" & _f & "',e:'" & _e & "',ano:" & dPersonagem[AnoEstreia] & ",er:" & dPersonagem[IdEra]
			                & ",me:'" & _me & "',cr:'" & _cr & "',j:'" & _j & "',v:" & _v & ",af:[" & _afs & "],ap:[" & _ap
			                & "],gr:" & _gr & ",in:" & FORMAT ( _in, "0.000###", "en-US" ) & "}",
			        ",", dPersonagem[IdPersonagem], ASC
			    )
			VAR _rel =
			    CONCATENATEX (
			        ALL ( fRelacao ),
			        VAR _t = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( fRelacao[TipoRelacao], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        RETURN "[" & fRelacao[IdOrigem] & "," & fRelacao[IdDestino] & ",'" & _t & "'," & fRelacao[Peso] & "]",
			        ",", fRelacao[IdOrigem], ASC, fRelacao[IdDestino], ASC
			    )
			VAR _g =
			    CONCATENATEX (
			        ALLNOBLANKROW ( dGolpe ),
			        VAR _n = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dGolpe[Nome], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        VAR _ef = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dGolpe[Efeito], "\", "\\" ), "'", "\'" ), "</", "<\/" ), UNICHAR ( 10 ), "\n" ), UNICHAR ( 13 ), "\r" )
			        RETURN
			            "{id:" & dGolpe[IdGolpe] & ",n:'" & _n & "',a:" & dGolpe[IdArquetipo] & ",c:'"
			                & IF ( dGolpe[Categoria] = "Físico", "F", "T" ) & "',pw:" & dGolpe[Poder] & ",ac:" & dGolpe[Precisao]
			                & ",ef:'" & _ef & "'}",
			        ",", dGolpe[IdGolpe], ASC
			    )
			VAR _vg =
			    CONCATENATEX ( ALL ( bVersaoGolpe ), "[" & bVersaoGolpe[IdVersao] & "," & bVersaoGolpe[IdGolpe] & "]", ",",
			        bVersaoGolpe[IdVersao], ASC, bVersaoGolpe[IdGolpe], ASC )
			RETURN
			    "window.GOTHAM={ar:[" & _ar & "],m:[" & _m & "],er:[" & _er & "],af:[" & _af & "],md:[" & _md & "],v:[" & _v
			        & "],p:[" & _p & "],rel:[" & _rel & "],g:[" & _g & "],vg:[" & _vg & "]};"
			```
		displayFolder: 40 JS

	measure 'Painel Barras Era' = ```
			-- Barras verticais: obras por era editorial
			VAR _max = MAXX ( dEra, CALCULATE ( COUNTROWS ( dObra ) ) )
			RETURN
			    CONCATENATEX (
			        dEra,
			        VAR _n = CALCULATE ( COUNTROWS ( dObra ) ) + 0
			        RETURN
			            "<div class='gd-col'><span class='gd-cv'>" & FORMAT ( _n, "0", "en-US" )
			                & "</span><span class='gd-ct'><i style='height:" & FORMAT ( DIVIDE ( _n, _max ) * 100, "0.0", "en-US" )
			                & "%'></i></span><span class='gd-cl'>" & dEra[Nome] & "</span></div>",
			        "",
			        dEra[Ordem], ASC
			    )
			```
		displayFolder: 50 Analítico

	measure 'Painel Barras Midia' = ```
			-- Barras horizontais: aparições por mídia
			VAR _max = MAXX ( dMidia, CALCULATE ( COUNTROWS ( fAparicao ) ) )
			RETURN
			    CONCATENATEX (
			        dMidia,
			        VAR _n = CALCULATE ( COUNTROWS ( fAparicao ) ) + 0
			        RETURN
			            "<div class='gd-bar'><span class='gd-bl'>" & dMidia[Nome] & "</span><span class='gd-bt'><i style='width:"
			                & FORMAT ( DIVIDE ( _n, _max ) * 100, "0.0", "en-US" ) & "%'></i></span><span class='gd-bv'>"
			                & FORMAT ( _n, "0", "en-US" ) & "</span></div>",
			        "",
			        CALCULATE ( COUNTROWS ( fAparicao ) ), DESC
			    )
			```
		displayFolder: 50 Analítico

	measure 'Painel Grade' = ```
			-- Grade de cards do arquivo de personagens: retrato (com fallback de silhueta), nome, codinome e faixa da facção
			CONCATENATEX (
			    dPersonagem,
			    VAR _img = LOOKUPVALUE ( dVersao[UrlImagem], dVersao[IdVersao], dPersonagem[IdPersonagem] * 100 + 1 )
			    VAR _nome = SUBSTITUTE ( SUBSTITUTE ( dPersonagem[Nome], "&", "&amp;" ), "<", "&lt;" )
			    VAR _civil = SUBSTITUTE ( SUBSTITUTE ( dPersonagem[IdentidadeCivil], "&", "&amp;" ), "<", "&lt;" )
			    VAR _arq = LOOKUPVALUE ( dArquetipo[Sigla], dArquetipo[IdArquetipo], dPersonagem[IdArquetipo] )
			    RETURN
			        "<div class='gd-ficha fx-" & dPersonagem[Faccao] & "'><div class='gd-foto'>"
			            & IF ( ISBLANK ( _img ), "", "<img src='" & _img & "' alt='' loading='lazy' onerror='this.remove()'>" )
			            & "</div><div class='gd-faixa'></div><b>" & _nome & "</b><span>" & _civil & "</span><em>#BAT-"
			            & FORMAT ( dPersonagem[IdPersonagem], "000", "en-US" ) & " · " & _arq & " · " & dPersonagem[Alinhamento]
			            & "</em></div>",
			    "",
			    dPersonagem[IdPersonagem], ASC
			)
			```
		displayFolder: 50 Analítico

	measure 'Painel Hubs' = ```
			-- Top 8 personagens por intermediação na rede de relações (quem conecta o universo)
			VAR _top = TOPN ( 8, dCentralidade, dCentralidade[Intermediacao], DESC, dCentralidade[Grau], DESC )
			VAR _max = MAXX ( _top, dCentralidade[Intermediacao] )
			RETURN
			    CONCATENATEX (
			        _top,
			        VAR _nome = LOOKUPVALUE ( dPersonagem[Nome], dPersonagem[IdPersonagem], dCentralidade[IdPersonagem] )
			        VAR _seguro = SUBSTITUTE ( SUBSTITUTE ( _nome, "&", "&amp;" ), "<", "&lt;" )
			        RETURN
			            "<div class='gd-bar'><span class='gd-bl'>" & _seguro & "</span><span class='gd-bt'><i style='width:"
			                & FORMAT ( DIVIDE ( dCentralidade[Intermediacao], _max ) * 100, "0.0", "en-US" )
			                & "%'></i></span><span class='gd-bv'>" & FORMAT ( dCentralidade[Grau], "0", "en-US" ) & " lig.</span></div>",
			        "",
			        dCentralidade[Intermediacao], DESC
			    )
			```
		displayFolder: 50 Analítico

	measure 'Painel KPIs' = ```
			-- Cartões de KPI do Painel do Comissário (HTML)
			VAR _pers = COUNTROWS ( dPersonagem )
			VAR _obras = COUNTROWS ( dObra )
			VAR _apar = COUNTROWS ( fAparicao )
			VAR _rel = COUNTROWS ( fRelacao )
			VAR _viloes = DIVIDE ( COUNTROWS ( FILTER ( dPersonagem, dPersonagem[Alinhamento] = "Vilão" ) ), _pers )
			VAR _card = "<div class='gd-kpi'><b>"
			RETURN
			    _card & FORMAT ( _pers, "0", "en-US" ) & "</b><span>personagens</span></div>"
			        & _card & FORMAT ( _obras, "0", "en-US" ) & "</b><span>obras</span></div>"
			        & _card & FORMAT ( _apar, "0", "en-US" ) & "</b><span>aparições</span></div>"
			        & _card & FORMAT ( _rel, "0", "en-US" ) & "</b><span>relações</span></div>"
			        & _card & FORMAT ( _viloes, "0%", "en-US" ) & "</b><span>vilões</span></div>"
			```
		displayFolder: 50 Analítico

	measure 'Spike Linhas' = ```
			-- Prova de leitura do modelo; ignora o filtro do slicer
			FORMAT ( CALCULATE ( COUNTROWS ( SpikeTamanho ), REMOVEFILTERS ( SpikeTamanho ) ), "0", "en-US" )
			```
		displayFolder: 99 Spike

	measure 'Spike Payload' = ```
			-- Payload sintético para medir o limite prático de tamanho de string no visual
			REPT ( "x", [Spike Tamanho] )
			```
		displayFolder: 99 Spike

	measure 'Spike Tamanho Rotulo' = ```
			FORMAT ( [Spike Tamanho], "#,0", "en-US" ) & " chars"
			```
		displayFolder: 99 Spike

	measure 'Spike Tamanho' = ```
			-- Nº de caracteres de payload escolhido no slicer (padrão 1.000)
			SELECTEDVALUE ( SpikeTamanho[Caracteres], 1000 )
			```
		formatString: #,0
		displayFolder: 99 Spike

	measure 'Tamanho HTML Spike' = ```
			LEN ( [HTML Spike] )
			```
		formatString: #,0
		displayFolder: 99 Spike

	measure 'Tamanho JS Gotham' = ```
			-- Tamanho da serialização (orçamento: limite prático medido na F0 é ~1 milhão de caracteres)
			LEN ( [JS Gotham] )
			```
		formatString: #,0
		displayFolder: 40 JS

	column _
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: _

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [_ = text], {})
				in
				    Fonte
