				let
				    Fonte = LerCsv("dMidia"),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"IdMidia", Int64.Type}, {"Nome", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
